# ===========================================
# Stage 1: Backend deps + build (if any)
# ===========================================
FROM node:26.3.0-alpine3.23 AS backend-build

RUN apk update && apk upgrade --no-cache \
    && npm install -g npm@latest
WORKDIR /app/backend

COPY backend/package*.json ./
RUN npm ci --omit=dev --ignore-scripts

COPY backend/ ./

# ===========================================
# Stage 2: Frontend (Angular) build only
# ===========================================
FROM node:26.3.0-alpine3.23 AS frontend-build
RUN apk update && apk upgrade --no-cache \
    && npm install -g npm@latest

WORKDIR /app/frontend

COPY frontend/package*.json ./
RUN npm ci --ignore-scripts

COPY frontend/ ./

RUN npm run build -- --configuration production

# ===========================================
# Stage 3: Debug Runtime (Alpine with shell for debugging)
# ===========================================
FROM alpine:3.23.4

RUN apk update && apk upgrade --no-cache \
    && apk add --no-cache \
        nodejs \
        git \
        ca-certificates \
        bash \
        htop \
    && apk add --no-cache --upgrade \
        libssl3 \
        libcrypto3 \
        musl \
        musl-utils \
        nghttp2-libs \
        libcurl \
        busybox \
        busybox-binsh \
        ssl_client \
    && rm -rf /usr/local/lib/node_modules/npm \
             /usr/local/bin/npm \
             /usr/local/bin/npx \
             /usr/local/bin/corepack \
    && rm -rf /var/cache/apk/*

ENV NODE_ENV=production \
    PORT=3000

WORKDIR /app/backend

COPY --from=backend-build /app/backend /app/backend

RUN mkdir -p /app/backend/public/browser
COPY --from=frontend-build /app/frontend/dist/frontend/browser /app/backend/public/browser

RUN rm -rf /app/frontend /app/node_module /root/.npm /usr/local/lib/node_modules

RUN chgrp -R 0 /app && chmod -R g+rwX /app

RUN addgroup -g 1001 appuser && \
    adduser -D -u 1001 -G appuser appuser && \
    adduser appuser root

USER 1001

EXPOSE 3000

STOPSIGNAL SIGTERM

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s \
  CMD node -e "require('http').get('http://127.0.0.1:'+(process.env.PORT||3000)+'/healthz',r=>process.exit(r.statusCode===200?0:1)).on('error',()=>process.exit(1))"

CMD ["node", "index.js"]

