# Debug runtime: the tested production application plus an interactive shell.
ARG PRODUCTION_IMAGE=mohankrishna999/git-repo:v55
ARG APK_REPOSITORY=https://apk.cgr.dev/chainguard

FROM ${PRODUCTION_IMAGE} AS debug
ARG APK_REPOSITORY

USER root
RUN printf '%s\n' "${APK_REPOSITORY}" > /etc/apk/repositories \
    && apk --timeout 60 add --no-cache bash \
    && rm -rf /var/cache/apk/*

USER 65532:0
